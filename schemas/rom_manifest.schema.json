{"$schema":"https://json-schema.org/draft/2020-12/schema","description":"A v5 binary manifest, as ARC-Apache's binary_manifest.schema.json defines it. The emulator implements the v5 format in its own code; this schema is the format contract. The payload is wrapped in an ARC_APACHE_BIN envelope and the ENVELOPE is chunked; manifest_sha256 is the hash of the manifest with manifest_sha256 set to null.","properties":{"chunk_size":{"minimum":1,"type":"integer"},"chunks":{"items":{"properties":{"index":{"minimum":0,"type":"integer"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"size_bytes":{"minimum":0,"type":"integer"},"store_path":{"type":"string"}},"required":["index","sha256","size_bytes","store_path"],"type":"object"},"minItems":1,"type":"array"},"codec":{"type":"string"},"content_class":{"type":"string"},"created_utc":{"type":"string"},"encryption":{"type":"object"},"envelope_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"envelope_size_bytes":{"minimum":0,"type":"integer"},"extra":{"type":"object"},"manifest_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"merkle_root":{"pattern":"^[0-9a-f]{64}$","type":"string"},"object_id":{"pattern":"^arcbin:[0-9a-f]{64}$","type":"string"},"parents":{"type":"array"},"source_path":{"type":["string","null"]},"version":{"const":5,"type":"integer"}},"required":["version","object_id","content_class","codec","envelope_sha256","envelope_size_bytes","chunk_size","chunks","merkle_root","manifest_sha256"],"title":"ARC Emulator Binary Manifest (v5)","type":"object"}