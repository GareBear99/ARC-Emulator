{"$schema":"https://json-schema.org/draft/2020-12/schema","description":"A v5 binary manifest with content_class 'save_state', with the session, system, and emulator core version nested under extra. A save-state manifest is a v5 binary manifest, so it also validates against rom_manifest.schema.json.","properties":{"chunk_size":{"minimum":1,"type":"integer"},"chunks":{"items":{"properties":{"index":{"minimum":0,"type":"integer"},"sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"size_bytes":{"minimum":0,"type":"integer"},"store_path":{"type":"string"}},"required":["index","sha256","size_bytes","store_path"],"type":"object"},"minItems":1,"type":"array"},"codec":{"type":"string"},"content_class":{"const":"save_state","type":"string"},"created_utc":{"type":"string"},"encryption":{"type":"object"},"envelope_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"envelope_size_bytes":{"minimum":0,"type":"integer"},"extra":{"additionalProperties":true,"properties":{"emulator_core_version":{"type":"string"},"session_id":{"type":"string"},"system":{"enum":["n64","gamecube","ps2","psp"]}},"required":["session_id","system","emulator_core_version"],"type":"object"},"manifest_sha256":{"pattern":"^[0-9a-f]{64}$","type":"string"},"merkle_root":{"pattern":"^[0-9a-f]{64}$","type":"string"},"object_id":{"pattern":"^arcbin:[0-9a-f]{64}$","type":"string"},"parents":{"type":"array"},"source_path":{"type":["string","null"]},"version":{"const":5,"type":"integer"}},"required":["version","object_id","content_class","codec","envelope_sha256","envelope_size_bytes","chunk_size","chunks","merkle_root","manifest_sha256","extra"],"title":"ARC Emulator Save State Manifest (v5)","type":"object"}